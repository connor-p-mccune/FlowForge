# Copy this file to .env and fill in values before running.
# Never commit .env to version control.

JWT_SECRET=change-me-to-a-long-random-string-for-dev
OPENAI_API_KEY=sk-...
VITE_API_URL=http://localhost:3001

# URL the Node backend uses to reach the Python AI service.
AI_SERVICE_URL=http://localhost:5000

# Optional: how many nodes of one run may execute concurrently (independent
# branches of the graph). 1 = strictly sequential. Default 4.
# EXEC_MAX_PARALLEL=4

# Optional: how long a real-time collaboration session waits after the last
# edit before writing the merged graph back to the workflow row. The session
# also flushes when the last collaborator leaves and on SIGTERM, so 0 disables
# only the periodic write, never durability. Default 2000 (ms).
# COLLAB_PERSIST_MS=2000

# Optional: bearer token required to scrape GET /metrics (Prometheus).
# Left unset, the endpoint is open — fine when the port isn't public.
# METRICS_TOKEN=

# Optional: dedicated key material for encrypting workspace secrets at rest
# (AES-256-GCM envelope encryption). Falls back to JWT_SECRET when unset.
# SECRETS_ENCRYPTION_KEY=

# Optional: the key ring. Secrets are encrypted under a per-secret data key,
# which is itself wrapped by one of these — so the wrapping key can be changed
# without every stored credential becoming undecryptable at once. Entries are
# "id:material", comma- or newline-separated; SECRETS_ACTIVE_KEY names the one
# new writes use (defaults to the last entry). Decryption picks the key by the
# id recorded on each row, so old and new keys coexist:
#
#   1. add the new key to the ring, keeping the old one
#   2. point SECRETS_ACTIVE_KEY at it and restart
#   3. Secrets → "Re-encrypt with current key" (or POST .../secrets/rotate)
#   4. once nothing reports the old id, drop it from the ring
#
# Unset, the vault uses a single key derived from the two variables above under
# the id "legacy" — which is exactly what an existing install already has.
# SECRETS_KEY_RING=legacy:...,2026q3:...
# SECRETS_ACTIVE_KEY=2026q3

# Optional: real delivery for the Send Email node. Without SMTP_HOST, email
# sends are simulated (serialised and logged, not delivered).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=flowforge@example.com
